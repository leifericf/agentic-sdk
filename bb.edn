{:paths ["src" "test"]

 ;; Development tasks for the SDK source repo. The spine tasks
 ;; (triage, lint, etc.) are invoked via the `agentic` CLI in
 ;; installed projects; this file only carries the test runner.

 :tasks
 {:requires ([babashka.fs :as fs]
            [clojure.test :as t])

  test
  {:doc "Run the spine test suite"
   :task (do
           (doseq [f (fs/glob "test" "**/*_test.clj")]
             (load-file (str f)))
           (let [{:keys [fail error]} (t/run-all-tests
                                       (re-pattern "spine\\..*-test"))]
             (println (format "test: %d fail, %d error" fail error))
             (when (pos? (+ fail error))
               (System/exit 1))))}}}
