# Project .gitignore dropped by bootstrap-project from templates/gitignore.
#
# Commit policy: only the committed-paths set is tracked. Everything else
# under .agentic-sdk/, the .claude/ adapter symlinks, and generated
# .opencode/ is regenerable by re-running bootstrap-project.
#
# Committed:
#   .agentic-sdk/project.edn
#   .agentic-sdk/artifacts/
#   CLAUDE.md
#   .claude/settings.json
#   .opencode/opencode.json

# .agentic-sdk/ is the neutral SDK master and state home. Ignore the
# snapped masters and the working state; commit only the descriptor and
# the artifacts tree (not ignored below, so they track by default).
.agentic-sdk/skills/
.agentic-sdk/agents/
.agentic-sdk/hooks/
.agentic-sdk/spine/
.agentic-sdk/templates/
.agentic-sdk/runs/
.agentic-sdk/state/
.agentic-sdk/settings.local.json

# .claude/ is the thin Claude Code adapter. The skills, agents, and
# hooks entries are symlinks into .agentic-sdk/; commit only the
# settings.json hook wiring.
.claude/skills
.claude/agents
.claude/hooks
.claude/settings.local.json

# .opencode/ is the OpenCode adapter. Commit only opencode.json; the
# agent projection and plugin are generated by opencode-sync.
.opencode/agent/
.opencode/plugins/
.opencode/node_modules/
